#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/studio.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* 默认主层 (Layer 0) */
        default_layer {
            bindings = <
                // Row 1
                &kp ESC  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
                // Row 2
                &kp TAB  &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp LBKT &kp RBKT &kp BSLH
                // Row 3
                &kp CAPS &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp SQT  &kp RET
                // Row 4
                &kp LSHFT &kp NUBS &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT  &kp SLASH &kp RSHFT &kp DEL
                // Row 5
                &kp LCTL &kp LGUI &kp LALT &kp SPACE &kp RALT &mo 1    &kp RCTL
            >;
        };

        /* 功能层 (Layer 1) - 通过右下角的 Fn 键触发 */
        fn_layer {
            bindings = <
                // Row 1: F1-F12
                &kp GRV  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12  &kp DEL
                // Row 2: 系统控制
                &kp BT_CLR &kp BT_SEL 0 &kp BT_SEL 1 &kp BT_SEL 2 &kp BT_SEL 3 &kp BT_SEL 4 &kp RGB_TOG &kp RGB_HUI &kp RGB_SAI &kp RGB_BRI &kp RGB_SPI &kp RGB_EFF &kp RGB_EFR
                // Row 3: 导航与媒体
                &kp LOCK &kp HOME &kp PG_UP &kp END &kp PG_DN &kp UP &kp MUTE &kp VOL_DN &kp VOL_UP &kp PLAY &kp PAUSE &kp LEFT &kp DOWN &kp RIGHT
                // Row 4: 辅助功能
                &kp LSHFT &kp INS &kp UNDO &kp CUT &kp COPY &kp PSTE &kp FIND &kp SEL_ALL &kp APP &kp M_PREV &kp M_NEXT &kp STOP &kp RSHFT &kp DEL
                // Row 5: 保持 Fn 或重置
                &kp LCTL &kp LGUI &kp LALT &kp SPACE &kp RALT &kp TRNS &kp RCTL
            >;
        };
    };
};
